rules_version = '2';

// エディタのアカウントごとのデータ（図・CSV・暗号化の鍵の情報）は users/{uid} 以下に置く。
// ログインした本人（uid が一致する場合）で、かつメールアドレスを確認済みのアカウントだけが
// 読み書きでき、それ以外はすべて拒否する（Google ログインは確認済みとして扱われる）。
//
// 図・CSVはブラウザ内で暗号化してから保存する（docs/encryption-design.md）。
// ここでは暗号化した形（暗号文と包んだ鍵）だけを書き込めるようにし、平文の名前や本文は書かせない。
// 暗号化機能より前の平文のデータは、読み出しと削除（暗号化して置き換えるため）だけを許す。
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null
          && request.auth.uid == uid
          && request.auth.token.email_verified == true;
    }

    // Base64 の文字列（長さの上限つき）
    function isB64(v, maxLen) {
      return v is string && v.size() > 0 && v.size() <= maxLen;
    }

    function hasExactly(m, keys) {
      return m is map && m.keys().hasOnly(keys) && m.keys().hasAll(keys);
    }

    // AES-GCM で暗号化した値（IV と暗号文）
    function isSealed(m, maxLen) {
      return hasExactly(m, ['iv', 'ct']) && isB64(m.iv, 32) && isB64(m.ct, maxLen);
    }

    // 暗号化した図・CSVの1件。暗号文は Firestore の1ドキュメントの上限（1MiB）に収まる大きさまで
    function isEncryptedItem(d) {
      return hasExactly(d, ['v', 'wrappedDek', 'iv', 'ct', 'updatedAt'])
          && d.v == 1
          && isSealed(d.wrappedDek, 128)
          && isB64(d.iv, 32)
          && isB64(d.ct, 1000000)
          && d.updatedAt is timestamp;
    }

    function isPassWrap(p) {
      return hasExactly(p, ['kdf', 'salt', 'iter', 'iv', 'wrappedMk'])
          && p.kdf == 'PBKDF2-SHA256'
          && p.iter is int && p.iter >= 600000
          && isB64(p.salt, 64) && isB64(p.iv, 32) && isB64(p.wrappedMk, 128);
    }

    function isRecoveryWrap(r) {
      return hasExactly(r, ['kdf', 'salt', 'iv', 'wrappedMk'])
          && r.kdf == 'HKDF-SHA256'
          && isB64(r.salt, 64) && isB64(r.iv, 32) && isB64(r.wrappedMk, 128);
    }

    // パスキーで包んだ主鍵（パスキーの ID → {prfSalt, iv, wrappedMk, label, createdAt}）。
    // ルールでは map の中身を1件ずつ調べられないので、件数だけ制限する。
    function isPasskeys(p) {
      return p is map && p.size() <= 10;
    }

    function isKeyring(k) {
      return k.keys().hasOnly(['v', 'pass', 'recovery', 'passkeys', 'createdAt', 'updatedAt'])
          && k.keys().hasAll(['v', 'pass', 'recovery', 'createdAt'])
          && k.v == 1
          && isPassWrap(k.pass)
          && isRecoveryWrap(k.recovery)
          && (!('passkeys' in k) || isPasskeys(k.passkeys))
          && k.createdAt is timestamp
          && (!('updatedAt' in k) || k.updatedAt is timestamp);
    }

    // 暗号化の鍵の情報（主鍵をパスフレーズと回復キーで包んだもの）
    match /users/{uid}/crypto/keyring {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
                    && isKeyring(request.resource.data)
                    && request.resource.data.createdAt == request.time;
      // 変えてよいのはパスフレーズ・パスキーで包んだ側だけ（回復キーで包んだ側と作成日時はそのまま）
      allow update: if isOwner(uid)
                    && isKeyring(request.resource.data)
                    && request.resource.data.recovery == resource.data.recovery
                    && request.resource.data.createdAt == resource.data.createdAt;
    }

    // 図の過去の版。上書き保存のときに作られ、あとから書き換えることはない（作成と削除だけ）
    match /users/{uid}/diagrams/{docId}/versions/{versionId} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && isEncryptedItem(request.resource.data);
    }

    // ---- 評価実験のアンケート（lib/survey.dart）----
    // 研究者が集計できるよう暗号化しない。回答者はログイン済み・メールアドレス確認済みの本人で、
    // 文書の名前を自分の uid にして 1 回だけ送れる（書き換え・削除はできない）。
    // 全員の回答を読めるのは admins/{uid} に登録した研究者だけ（登録は Firebase コンソールで行う）。
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isLikert(v) {
      return v is int && v >= 1 && v <= 5;
    }

    function isFreeText(v) {
      return v is string && v.size() <= 2000;
    }

    // 質問を変えたら lib/survey.dart と一緒に変え、surveyId の番号を上げる
    function isSurveyAnswers(a) {
      return hasExactly(a, ['gsn_exp', 'prog_exp',
                            'sus1', 'sus2', 'sus3', 'sus4', 'sus5',
                            'sus6', 'sus7', 'sus8', 'sus9', 'sus10',
                            'good', 'bad'])
          && a.gsn_exp in ['none', 'seen', 'wrote']
          && a.prog_exp in ['lt1', '1to3', 'gt3']
          && isLikert(a.sus1) && isLikert(a.sus2) && isLikert(a.sus3) && isLikert(a.sus4)
          && isLikert(a.sus5) && isLikert(a.sus6) && isLikert(a.sus7) && isLikert(a.sus8)
          && isLikert(a.sus9) && isLikert(a.sus10)
          && isFreeText(a.good) && isFreeText(a.bad);
    }

    match /surveys/{surveyId}/responses/{uid} {
      // 本人は「もう答えたか」を確かめるために自分の回答だけ読める
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(uid)
                    && surveyId == 'editor-eval-v1'
                    && hasExactly(request.resource.data, ['participantId', 'answers', 'submittedAt'])
                    && request.resource.data.participantId is string
                    && request.resource.data.participantId.size() <= 40
                    && isSurveyAnswers(request.resource.data.answers)
                    && request.resource.data.submittedAt == request.time;
    }

    // 研究者の登録。本人が自分の登録を確かめられるだけで、アプリからは書けない
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
    }

    // 図・CSV
    match /users/{uid}/{collection}/{docId} {
      allow read, delete: if isOwner(uid) && collection in ['diagrams', 'csvFiles'];
      allow create, update: if isOwner(uid)
                            && collection in ['diagrams', 'csvFiles']
                            && isEncryptedItem(request.resource.data);
    }
  }
}
